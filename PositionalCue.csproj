<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.0.0</Version>
    <Author>CheesyChiz</Author>
    <Name>Positional Cue</Name>
    <InternalName>PositionalCue</InternalName>
    <Punchline>Positional hints from Wrath Combo, BossMod Reborn or Rotation Solver Reborn.</Punchline>
    <Description>Rear/flank HUD and target ring with sound cues. Manual or automatic source selection. Wrath supports action countdowns; Reborn and RSR provide direction-only hints on your selected target. Requires one supported rotation plugin. Settings: /pcue.</Description>
    <Tags>positional;wrath;melee;overlay</Tags>
    <RepoUrl>https://github.com/CheesyChiz/PositionalCue</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/CheesyChiz/PositionalCue/main/assets/icon.png</IconUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
