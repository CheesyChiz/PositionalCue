<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.0</Version>
    <Author>CheesyChiz</Author>
    <Name>Positional Cue</Name>
    <InternalName>PositionalCue</InternalName>
    <Punchline>Upcoming rear/flank hints and a gentle sound cue from Wrath Combo.</Punchline>
    <Description>Displays upcoming Wrath Combo positionals as a draggable HUD or a target ring highlighting rear/flank. Includes optional sound cues, English/Russian settings and integration status. Requires Wrath Combo. Settings: /pcue.</Description>
    <Tags>positional;wrath;melee;overlay</Tags>
    <RepoUrl>https://github.com/CheesyChiz/PositionalCue</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/CheesyChiz/PositionalCue/main/assets/icon.png</IconUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
