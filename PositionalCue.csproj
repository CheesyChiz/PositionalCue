<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.5.0.0</Version>
    <Author>CheesyChiz</Author>
    <Name>Positional Cue</Name>
    <InternalName>PositionalCue</InternalName>
    <Punchline>Positional hints and an optional Wrath spell forecast.</Punchline>
    <Description>Positional HUD and target ring with sound cues. Optional experimental Wrath ST/AoE combo-button forecast with current adjusted cast time and per-job hotbar bindings. Reborn and RSR supply direction-only positional hints. No movement or action execution. Settings: /pcue.</Description>
    <Tags>positional;wrath;melee;overlay</Tags>
    <RepoUrl>https://github.com/CheesyChiz/PositionalCue</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/CheesyChiz/PositionalCue/main/assets/icon.png</IconUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
